# izdock/server-manager image and component versions and checksums (single source of truth).
#
# Read by build/install.sh (inside the image build, via build/lib.sh load_versions),
# by tools/build.sh (local build) and by the Gitea workflows (base image, image version and tags).
# Plain KEY=value lines only: no spaces, no quotes, no commands.
# Every *_SHA256 is the sha256 of the exact file that is downloaded.
# The file is also shipped in the image: /usr/src/server-manager/versions.env

## image version: the tags are APP_VER, X.Y, X, APP_VER-<build>, latest (.gitea/actions/image-tags)
# bump it for every release (it replaces the git tag of the old Drone pipeline)
APP_VER=2.0.2

## base image - https://hub.docker.com/_/debian
# the image is docker.io/library/debian:<CODENAME>-slim@<DIGEST>: the digest pins the content
DEBIAN_CODENAME=trixie
DEBIAN_DIGEST=sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

## https://www.adminer.org/#download (adminer-<VER>.php)
ADMINER_VERSION=6.3.1
ADMINER_SHA256=a9aed04e4e68c4e46283804a69ee70cad4fbf23203b46470b760868b2fd9bd76

## https://www.phpmyadmin.net/downloads/ (phpMyAdmin-<VER>-all-languages.tar.gz)
PMA_VERSION=5.2.3
PMA_SHA256=12ba1c425fa4071abbd4e7668c9ebdeac0b0755a467a6d6d5026122bb47c102b

## https://www.zabbix.com/download_agents
# ZABBIX_VERSION: the release line of the apt repository; ZABBIX_RELEASE: its zabbix-release package
ZABBIX_VERSION=7.0
ZABBIX_RELEASE=7.0-5
ZABBIX_RELEASE_SHA256=4a926b8815cdefddc31558fe622676730a3987610f75d5af0d4024809d21dd43

## https://dev.mysql.com/downloads/repo/apt/ (mysql-apt-config_<VER>_all.deb)
# MYSQL_SERIES: the series selected in mysql-apt-config (mysql-<SERIES>)
MYSQL_APT_CONFIG_VERSION=0.8.36-1
MYSQL_APT_CONFIG_SHA256=4d7db2369b1430152eb46cfa35e2576ea32fdbbb6501cbab8261654b8fbb6234
MYSQL_SERIES=8.4-lts

## https://nodejs.org/ (major: the NodeSource apt repository)
NODEJS_VERSION=24

## https://github.com/jhuckaby/Cronicle/releases (tag archive, requires Node.js >= 22.12)
CRONICLE_VERSION=0.9.147
CRONICLE_SHA256=6c3058766250f0850f2848c545051c06c60a8e37e230ecca451b1f58d0794203

## https://github.com/GoogleCloudPlatform/gcsfuse (apt package version of the Google repository)
GCSFUSE_VERSION=3.13.1

## tools
# https://github.com/ugoviti/izmysqlsync (tag archive)
IZMYSQLSYNC_VER=2.0.4
IZMYSQLSYNC_SHA256=9433d18d688f4266f56d128e292f85cbdc8b4e5bdb6bcf6b1d2123e8c17406df
# https://github.com/ugoviti/izmysqlrestore (no tags: pinned commit of the main branch)
IZMYSQLRESTORE_COMMIT=31c4c3a66c0e19e300f5d343a9cb88f63f980ea8
IZMYSQLRESTORE_SHA256=3314534b43be56f347a3c7f1e72320c452314442e724d055b2604e8c72ff71c0
# https://github.com/major/MySQLTuner-perl (mysqltuner.pl of the tag)
MYSQLTUNER_VER=2.9.4
MYSQLTUNER_SHA256=775b1e34dbf579e3114e8ade268f56159023c08a0b7ecfc89ad51ca939355806
