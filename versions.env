# izdock/server-manager image and component versions (single source of truth).
#
# Read by the Dockerfile (build/lib.sh load_versions, inside the image build),
# by tools/build.sh (local build) and by the Gitea workflows (image version and tags).
# Plain KEY=value lines only: no spaces, no quotes, no commands.
# The file is also shipped in the image: /usr/src/server-manager/versions.env

## image version: the tags are APP_VER, X.Y, X, APP_VER-<build>, latest (.gitea/actions/image-tags)
# bump it for every release (it replaces the git tag of the old Drone pipeline)
APP_VER=1.14.3

## https://www.adminer.org/#download
ADMINER_VERSION=5.0.4

## https://www.phpmyadmin.net/downloads/
PMA_VERSION=5.2.2

## https://www.zabbix.com/download_agents (major.minor: the apt repository of that release)
ZABBIX_VERSION=7.0

## https://nodejs.org/ (major: the NodeSource apt repository)
NODEJS_VERSION=20

## https://github.com/jhuckaby/Cronicle/releases
CRONICLE_VERSION=0.9.76

## https://github.com/GoogleCloudPlatform/gcsfuse
# NOT applied yet: apt installs the latest gcsfuse of the Google repository (see SPEC-UPGRADE.md)
GCSFUSE_VERSION=2.10.0
